<Window x:Class="BIMSeedFiller.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="种子填充工具" Height="500" Width="300"
        MinHeight="400" MinWidth="280">
    <Grid Margin="5">
        <Grid.RowDefinitions>
            <!-- 标题 -->
            <RowDefinition Height="Auto"/>
            <!-- 种子信息 -->
            <RowDefinition Height="Auto"/>
            <!-- 预览区域（自动填充剩余空间） -->
            <RowDefinition Height="*" MinHeight="150"/>
            <!-- 按钮区域 -->
            <RowDefinition Height="Auto"/>
            <!-- 状态栏 -->
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 标题 -->
        <TextBlock Grid.Row="0" Text="种子填充工具" 
                   FontSize="18" FontWeight="Bold" 
                   HorizontalAlignment="Center" Margin="0,5"/>

        <!-- 种子信息 -->
        <GroupBox Grid.Row="1" Header="种子信息" Margin="10,5,10,5">
            <StackPanel Margin="5">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <TextBlock Text="宽度:" VerticalAlignment="Center" Margin="5"/>
                    <TextBlock Text="{Binding SeedData.Width}" Width="60" Margin="5"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <TextBlock Text="高度:" VerticalAlignment="Center" Margin="5"/>
                    <TextBlock Text="{Binding SeedData.Height}" Width="60" Margin="5"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <TextBlock Text="角度:" VerticalAlignment="Center" Margin="5"/>
                    <TextBlock Text="{Binding SeedData.Rotation}" Width="60" Margin="5"/>
                </StackPanel>
            </StackPanel>
        </GroupBox>

        <!-- 预览 Canvas -->
        <Border Grid.Row="2" BorderBrush="Gray" BorderThickness="1" Margin="10,0,10,0">
            <Canvas x:Name="PreviewCanvas" Background="White"/>
        </Border>

        <!-- 按钮区域 -->
        <StackPanel Grid.Row="3" Margin="10,10,10,0">
            <!-- 第一行按钮 -->
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <Button Content="选择种子" Width="65" Height="25" Margin="5,0" Command="{Binding getSeedCommand}"/>
                <Button Content="选择边界" Width="65" Height="25" Margin="5,0" Command="{Binding getBoundaryCommand}"/>
                <Button Content="预览效果" Width="65" Height="25" Margin="5,0" Command="{Binding PreviewCommand}"/>
            </StackPanel>
            <!-- 第二行按钮 -->
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,8,0,0">
                <Button Content="重置数据" Width="65" Height="25" Margin="5,0" Command="{Binding ClearCommand}"/>
                <Button Content="开始填充" Width="65" Height="25" Margin="5,0" Command="{Binding FillCommand}"/>
            </StackPanel>
        </StackPanel>

        <!-- 状态栏 -->
        <Border Grid.Row="4" Background="#F0F0F0" BorderBrush="Gray" BorderThickness="0,1,0,0" Padding="5" Margin="5,5,0,0">
            <TextBlock Text="{Binding Status}" FontSize="12"/>
        </Border>
    </Grid>
</Window>