<Window x:Class="BIMSeedFiller.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:BIMSeedFiller.Wpf"
        mc:Ignorable="d"
        Title="种子填充工具" Height="500" Width="300">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="种子填充工具" 
                   FontSize="20" 
                   FontWeight="Bold" 
                   HorizontalAlignment="Center" 
                   Margin="10"/>

        <Border Grid.Row="1" Background="AliceBlue" Margin="0, 0, 0, 10" Width="250">
            <GroupBox Header="种子信息" Foreground="Gray">
                <StackPanel Margin="10">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <TextBlock Text="宽度:" VerticalAlignment="Center" Margin="5"/>
                        <TextBlock Text="{Binding SeedData.Width}" Width="60" Margin="5"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <TextBlock Text="高度:" VerticalAlignment="Center" Margin="5"/>
                        <TextBlock Text="{Binding SeedData.Height}" Width="60" Margin="5"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <TextBlock Text="角度:" VerticalAlignment="Center" Margin="5"/>
                        <TextBlock Text="{Binding SeedData.Rotation}" Width="60" Margin="5"/>
                    </StackPanel>
                </StackPanel>
            </GroupBox>
        </Border>

        <Grid Grid.Row="2" Margin="10">
            <Grid.RowDefinitions>
                <RowDefinition Height="20"></RowDefinition>
                <RowDefinition Height="auto"></RowDefinition>
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                <Button Content="选择种子" Width="50" Height="20" Margin="0,0,10,0" Command="{Binding getSeedCommand}"/>
                <Button Content="选择边界" Width="50" Height="20" Margin="0,0,10,0" Command="{Binding getBoundaryCommand}"/>
                <Button Content="开始填充" Width="50" Height="20" Command="{Binding FillCommand}"/>
            </StackPanel>
        </Grid>


        <Border Grid.Row="3" Background="#F0F0F0" BorderBrush="Gray" BorderThickness="0,1,0,0" Padding="5" Margin="0,5,0,0">
            <TextBlock x:Name="txtStatus" Text="就绪..." FontSize="12"/>
        </Border>
    </Grid>
</Window>
